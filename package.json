{
  "//": "This SDK builds and releases independently and has no runtime dependency on the Facta application monorepo. Its HTTP contract is checked against the published OpenAPI document.",
  "name": "@facta-dte/api",
  "version": "0.5.0",
  "description": "TypeScript client for the Facta electronic invoicing API (DTE) in El Salvador.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Facta-DTE/facta-api-sdk.git"
  },
  "homepage": "https://github.com/Facta-DTE/facta-api-sdk#readme",
  "bugs": {
    "url": "https://github.com/Facta-DTE/facta-api-sdk/issues"
  },
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types/mod.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./file-archive": {
      "types": "./dist/types/src/file-archive.d.ts",
      "import": "./dist/file-archive.js",
      "default": "./dist/file-archive.js"
    },
    "./node": {
      "types": "./dist/types/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/types/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./react/styles.css": "./dist/react/styles.css",
    "./server": {
      "types": "./dist/types/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "types": "./dist/types/mod.d.ts",
  "files": [
    "mod.ts",
    "node.ts",
    "browser.ts",
    "react.ts",
    "src",
    "dist",
    "examples",
    "preview",
    ".env.example",
    "guides",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "deno test --allow-read --allow-write --allow-net .",
    "test:local-s3-storage": "pnpm build && node scripts/test-s3-local-storage.mjs",
    "pack:check": "pnpm build && node scripts/check-packed-consumer.mjs",
    "test:react": "vitest run --config vitest.config.ts",
    "test:browser": "deno test --allow-read --allow-write --allow-net test/browser-*.test.ts test/architecture.test.ts",
    "typecheck:react": "tsc --noEmit -p tsconfig.react.json",
    "build:preview": "node scripts/build-preview.mjs",
    "playground:dev": "pnpm playground:build && wrangler dev -c playground/wrangler.jsonc",
    "playground:build": "vite build --config playground/vite.config.ts",
    "playground:typecheck": "tsc --noEmit -p playground/tsconfig.worker.json && tsc --noEmit -p playground/tsconfig.site.json",
    "playground:test": "vitest run --config playground/vitest.config.ts",
    "playground:smoke": "playwright test --config playground/playwright.config.ts",
    "playground:deploy:check": "pnpm playground:build && wrangler deploy -c playground/wrangler.jsonc --env \"\" --dry-run --outdir playground/.wrangler/dry-run"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.19.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.25.12",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
